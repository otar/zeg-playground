{
  "name": "@otar/zeg",
  "version": "0.1.0",
  "description": "A small CQRS library for Cloudflare Workers",
  "keywords": [
    "cqrs",
    "command",
    "query",
    "cloudflare",
    "workers",
    "vite"
  ],
  "license": "MIT",
  "author": "Otar Chekurishvili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otar/zeg-playground.git"
  },
  "type": "module",
  "exports": "./src/zeg.js",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:node": "vitest run --project node",
    "coverage": "vitest run --project unit --coverage && node scripts/check-coverage.js",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "types": "tsc -p jsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src --outDir src && prettier --write src/zeg.d.ts",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.8",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
